# Google Gen AI SDK — Gemini API key (get one at https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Model to use. Default: gemini-2.5-flash (reliable + supports grounding/structured output).
# For the Gemini 3 features from the lab (e.g. thinking_level), set:
# GEMINI_MODEL=gemini-3-pro-preview
GEMINI_MODEL=gemini-2.5-flash
