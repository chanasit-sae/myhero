# Google Gen AI SDK — Gemini API key (get one at https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Model to use. Lab GSP1150 uses Gemini 3.1 Pro / Gemini 3.5 Flash.
# thinking_level needs a Gemini 3 model. No Gemini 3 access? use gemini-2.5-flash.
# GEMINI_MODEL=gemini-3.1-pro
GEMINI_MODEL=gemini-3.5-flash
